# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ============================================
# Environment Files (NEVER commit secrets)
# ============================================
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.sample

# ============================================
# Dependencies
# ============================================
node_modules/
/.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
jspm_packages/
.npm
.pnpm-store/

# ============================================
# Build & Distribution Output
# ============================================
dist/
build/
out/
.next/
.nuxt/
.output/
*.tsbuildinfo
*.d.ts.map
next-env.d.ts

# NestJS Backend
server/dist/
server/build/
server/coverage/
server/*.tsbuildinfo
server/.nestjs_repl_history

# React/Next Frontend
frontend/dist/
frontend/build/
frontend/.next/
frontend/coverage/

# ============================================
# Testing / coverage
# ============================================
coverage/
/coverage
*.lcov
.nyc_output
junit.xml

# ============================================
# Caches
# ============================================
.cache/
.turbo/
.eslintcache
.stylelintcache
.parcel-cache/
*.tgz
__pycache__/

# ============================================
# Logs & debug
# ============================================
logs/
log/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ============================================
# Docker
# ============================================
docker-compose.override.yml
postgres-data/
redis-data/
mongo-data/
pgdata/
pgsql/
data/
volumes/

