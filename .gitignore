# Databases (dumps / data)
# ============================================
*.dump
*.sql.gz
*.backup
*.pgdump
dump.rdb
*.rdb
appendonly.aof
*.aof

# ============================================
# AI / LLM / ML artifacts
# ============================================
models/
*.gguf
*.bin
*.onnx
*.pt
*.pth
*.safetensors

# ============================================
